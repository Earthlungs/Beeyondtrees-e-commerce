generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  password           String
  name               String
  role               String    @default("merchant")
  active             Boolean   @default(true) // blocked/deactivated users can't log in
  // Staff provisioning (IT Specialist): value-chain users log in with their
  // first name as username and their phone as the initial password, then must
  // change it. email is auto-filled firstname@earthlungs.org.
  email              String?   @unique
  phone              String?
  country            String    @default("Kenya") // Kenya | Tanzania
  image              String? // profile picture URL (Cloudinary)
  mustChangePassword Boolean   @default(false)
  theme              String    @default("system") // per-user UI theme: system | dark
  lastSeenAt         DateTime? // updated as the user polls chat — powers "last seen / online"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ── Attendance (office sign in / sign out) ─────────────────────────────────
// One row per punch. `type` is "in" or "out". The browser captures the live GPS
// fix at the moment the button is pressed; the server reverse-geocodes it (via
// Mapbox) and stores the human-readable address alongside the raw coordinates,
// so the admin map still works if the geocoder is ever unavailable. No FK to
// User — same read-only-link convention as Message.
model Attendance {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  role       String
  type       String // in | out
  at         DateTime @default(now())
  latitude   Float
  longitude  Float
  accuracy   Float? // GPS accuracy radius in metres, as reported by the browser
  address    String? // reverse-geocoded place name (Mapbox)
  note       String?
  device     String? // user agent, trimmed
  ip         String?
  // Only set on an "out" punch: minutes since that day's matching "in".
  workedMins Int?

  @@index([userId, at])
  @@index([at])
}

// ── Leave requests ─────────────────────────────────────────────────────────
// Any staff member applies; ONLY the CEO (role "admin") may approve or reject.
// The CEO is emailed on every new request, and the applicant is emailed on the
// decision. Applicants may cancel their own request while it is still pending.
model LeaveRequest {
  id           String    @id @default(cuid())
  reference    String    @unique // LV-0001
  userId       String
  userName     String
  userEmail    String?
  role         String
  type         String // annual | sick | maternity | paternity | compassionate | unpaid | study | other
  startDate    DateTime
  endDate      DateTime
  days         Int // inclusive day count
  reason       String    @db.Text
  handoverTo   String? // colleague covering the duties
  contact      String? // reachable phone/email while away
  status       String    @default("pending") // pending | approved | rejected | cancelled
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// In-app 1:1 chat between staff. Polled (~4s) by the chat UI; no FK to User to
// stay light, matching the read-only-link convention used elsewhere.
model Message {
  id         String    @id @default(cuid())
  fromUserId String
  toUserId   String
  body       String    @db.Text
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([fromUserId, toUserId, createdAt])
}

// Customer invoice (branded printable doc, matches templates/Invoice). Line
// items are stored as JSON: [{ description, qty, unitPrice, taxRate, amount,
// productId? }] — `productId` is present when the line was picked from the
// product catalog, which is what makes the stock deduction below possible.
model Invoice {
  id              String    @id @default(cuid())
  number          String    @unique // e.g. INV-0001
  date            DateTime  @default(now())
  dueDate         DateTime?
  customerName    String
  customerContact String? // phone / email
  items           Json      @default("[]")
  subtotal        Float     @default(0)
  vat             Float     @default(0)
  total           Float     @default(0)
  notes           String?   @db.Text // payment details
  // Payment tracking. Whoever raised the invoice (or finance / CEO) flips this
  // once the money lands — same shape as the Lpo paid/paidBy/paidAt columns,
  // which the finance dashboard already reads.
  paid            Boolean   @default(false)
  paidAt          DateTime?
  paidBy          String?
  paymentMethod   String? // cash | mpesa | bank | cheque | card | other
  paymentRef      String? // M-Pesa code, bank slip, cheque number…
  // Catalog lines decrement Product.stock the moment the invoice is raised.
  // The flag makes that a once-only effect, so a retry can never double-deduct.
  stockDeducted   Boolean   @default(false)
  createdByUserId String? // who raised it — they may mark it paid
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Local Purchase Order to a supplier (branded printable doc, matches
// templates/Purchase Order). Same JSON line-item shape as Invoice.
model Lpo {
  id              String    @id @default(cuid())
  number          String    @unique // e.g. LPO-0001
  orderDate       DateTime  @default(now())
  expectedArrival DateTime?
  supplierName    String
  shippingAddress String?   @db.Text
  purchaseRep     String?
  items           Json      @default("[]")
  subtotal        Float     @default(0)
  vat             Float     @default(0)
  total           Float     @default(0)
  notes           String?   @db.Text
  // Approval, destination, and rejection fields are NOT in the Prisma schema —
  // they live as raw DB columns applied via migration. Using raw SQL for them
  // keeps Prisma queries working before and after the migration runs.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Quotation — LPO clone minus payment details (no notes / paid tracking).
// New table, so ALL columns are modelled here (no raw-column split like Lpo).
model Quotation {
  id                 String    @id @default(cuid())
  number             String    @unique // e.g. QUO-0001
  orderDate          DateTime  @default(now())
  expectedArrival    DateTime?
  supplierName       String
  shippingAddress    String?   @db.Text // "Source of Supply" on the doc
  purchaseRep        String?
  items              Json      @default("[]")
  subtotal           Float     @default(0)
  vat                Float     @default(0)
  total              Float     @default(0)
  status             String    @default("pending")
  approvedBy         String?
  approvedAt         DateTime?
  rejectionReason    String?   @db.Text
  destinationOfGoods String?
  amended            Boolean   @default(false)
  onBehalf           Boolean   @default(false)
  origin             String?
  createdByUserId    String?
  createdByName      String?
  chiefApprovedBy    String?
  chiefApprovedAt    DateTime?
  recipientEmail     String?
  attachmentUrl      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Delivery Note — the document that travels WITH the goods, raised against an
// already-approved LPO. Deliberately different from the LPO/Quotation pair:
//   * no approval chain — it is printable and emailable the moment it is saved,
//     because goods cannot wait on a sign-off queue; and
//   * no money. Its `items` carry { description, unit, qtyOrdered, qtyDelivered,
//     remarks } — the LPO and invoice hold the pricing, this proves what
//     physically arrived (hence qtyDelivered vs qtyOrdered, and receivedBy).
// `lpoId` is a soft reference with no FK, same convention as Batch.lpoId —
// `lpoNumber` is snapshotted so the printed note stays readable regardless.
model DeliveryNote {
  id              String   @id @default(cuid())
  number          String   @unique // e.g. DN-0001
  lpoId           String? // approved Lpo this note delivers against (no FK)
  lpoNumber       String? // snapshot, so the doc reads correctly on its own
  supplierName    String
  deliveredTo     String? // destination of goods (from the LPO, editable)
  deliveryDate    DateTime @default(now())
  vehicleReg      String? // motorbike/lorry plate
  driverName      String?
  driverPhone     String?
  receivedBy      String? // who signs for the goods at the destination
  items           Json     @default("[]")
  notes           String?  @db.Text
  recipientEmail  String?
  attachmentUrl   String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lpoId])
}

// PDF document attachments stored in Postgres (Cloudinary blocks PDF delivery
// on this plan). Served by /api/attachments/[id].
model DocAttachment {
  id        String   @id
  filename  String?
  mime      String   @default("application/pdf")
  data      Bytes
  createdAt DateTime @default(now())
}

model Product {
  id                    String      @id @default(cuid())
  name                  String
  description           String      @db.Text
  category              String
  retailPrice           Float
  wholesalePrice        Float
  distributorPrice      Float
  costPrice             Float       @default(0) // buying/production cost, for profit calc (admin-only, never in public catalog)
  stock                 Int         @default(0)
  images                Json        @default("[]")
  isOnOffer             Boolean     @default(false)
  offerPrice            Float? // retail offer price (when isOnOffer)
  offerWholesalePrice   Float? // wholesale offer price
  offerDistributorPrice Float? // distributor offer price
  isFeatured            Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  orderItems            OrderItem[]
}

model Order {
  id                   String      @id @default(cuid())
  customerName         String
  customerPhone        String
  customerEmail        String?
  county               String
  town                 String
  landmark             String?
  deliveryInstructions String?     @db.Text
  total                Float
  status               String      @default("pending")
  paymentRef           String?
  paymentStatus        String?
  transactionRef       String?
  // Sales channel: "online" (web checkout) or "pos" (physical shop till).
  // Both decrement the same Product.stock, so the two storefronts stay in sync.
  channel              String      @default("online")
  // POS-only fields. paymentMethod is "cash" | "mpesa" | "card".
  paymentMethod        String?
  cashReceived         Float? // amount tendered for cash sales (for change)
  mpesaCode            String? // M-Pesa confirmation code
  cardRef              String? // card/terminal reference
  soldBy               String? // name of the cashier who rang up the sale
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  items                OrderItem[]
  dispatch             Dispatch?
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  price       Float // actual sold unit price (after any POS discount)
  markedPrice Float? // POS: original tier price before the till discount; null = no discount
  discount    Float   @default(0) // POS: KSh knocked off per unit at the till
  quantity    Int
  pricingTier String
  subtotal    Float
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model Dispatch {
  id                String    @id @default(cuid())
  orderId           String    @unique
  riderName         String
  riderPhone        String
  motorbikePlate    String
  riderIdNo         String
  dispatchedAt      DateTime  @default(now())
  estimatedDelivery DateTime?
  createdAt         DateTime  @default(now())
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ── Traceability subsystem ─────────────────────────────────────────────────
// Tracks a product from raw material → finished, received goods through a
// strictly-sequential 9-stage, role-gated pipeline, then reconciles the
// rolled-up production cost against the live website selling price (read-only —
// this subsystem NEVER writes to Product). `stage` is the one open stage; the
// matching role can only act when batch.stage === their stage (see lib/tracing).
model Batch {
  id                   String   @id @default(cuid())
  code                 String   @unique // BTR-0001
  stage                String   @default("bulk_request") // current open stage (STAGES in lib/tracing)
  status               String   @default("in_progress") // in_progress | rejected | completed
  productName          String? // finished good, used to fuzzy-match the catalog
  lpoId                String? // LPO that initiated this batch (marks LPO as consumed)
  matchedProductId     String? // resolved catalog Product.id (read-only link, no FK)
  sellingPriceSnapshot Float? // price captured at reconcile time
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bulkRequest  BulkRequest?
  approval     Approval?
  sourcing     Sourcing?
  inspection   Inspection?
  requisitions Requisition[] // 1:many — multi-user requisition officers
  issuance     Issuance?
  production   Production?
  dispatch     BatchDispatch?
  receiving    Receiving?
}

// Stage 1 — Factory manager
model BulkRequest {
  id                 String    @id @default(cuid())
  batchId            String    @unique
  requestId          String    @unique // BTR-REQ-0001
  sector             String
  materialCategory   String
  materialName       String
  quantityRequested  Float
  unitOfMeasure      String
  expectedDate       DateTime?
  estimatedUnitCost  Float     @default(0)
  estimatedTotalCost Float     @default(0)
  purpose            String?   @db.Text
  requestedBy        String
  approvedBy         String? // filled at the approval stage
  status             String    @default("pending")
  createdAt          DateTime  @default(now())
  batch              Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Stage 2 — Executive (accept / reject)
model Approval {
  id         String   @id @default(cuid())
  batchId    String   @unique
  decision   String // accepted | rejected
  reason     String?  @db.Text // required on reject; surfaced to the Factory manager
  approvedBy String
  decidedAt  DateTime @default(now())
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Stage 3 — Procurement officer (harvest / sourcing)
model Sourcing {
  id                String   @id @default(cuid())
  batchId           String   @unique
  harvestId         String   @unique // HRV-0001
  materialName      String
  sourceLocation    String
  gps               String?
  quantityHarvested Float    @default(0)
  laborCost         Float    @default(0)
  transportCost     Float    @default(0)
  otherCosts        Float    @default(0)
  totalHarvestCost  Float    @default(0)
  supervisor        String?
  images            Json     @default("[]")
  remarks           String?  @db.Text
  createdAt         DateTime @default(now())
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Stage 4 — Quality inspector (receiving inspection)
model Inspection {
  id                String   @id @default(cuid())
  batchId           String   @unique
  receivingId       String   @unique // RCV-0001
  harvestId         String?
  materialName      String
  quantityDelivered Float    @default(0)
  quantityAccepted  Float    @default(0)
  quantityRejected  Float    @default(0)
  qualityGrade      String?
  inspector         String
  storeLocation     String?
  images            Json     @default("[]")
  remarks           String?  @db.Text
  createdAt         DateTime @default(now())
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Stage 5 — Requisition officer (internal requisition, multi-user → 1:many)
model Requisition {
  id               String   @id @default(cuid())
  batchId          String
  requisitionId    String   @unique // REQ-0001
  department       String
  product          String
  quantityRequired Float    @default(0)
  issuedQty        Float    @default(0) // cumulative issued at the issuance stage (partial allowed)
  purpose          String?  @db.Text
  requestedBy      String // the logged-in requisition officer
  status           String   @default("pending") // "issued" once issuedQty >= quantityRequired
  createdAt        DateTime @default(now())
  batch            Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Stage 6 — Agribusiness manager (issuance)
model Issuance {
  id                    String   @id @default(cuid())
  batchId               String   @unique
  requisitionId         String? // human ref to a Requisition.requisitionId
  department            String
  product               String
  customProductOrSample String?
  numberToManufacture   Int      @default(0)
  productImage          Json     @default("[]")
  material              String
  quantityRequired      Float    @default(0)
  purpose               String?  @db.Text
  requestedBy           String
  jobCardNumber         String?
  approvedBy            String?
  status                String   @default("pending")
  createdAt             DateTime @default(now())
  batch                 Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Stage 7 — Production officer
model Production {
  id             String    @id @default(cuid())
  batchId        String    @unique
  issueId        String    @unique // ISS-0001
  requisitionId  String?
  material       String
  quantityIssued Float     @default(0)
  unitCost       Float     @default(0)
  totalCost      Float     @default(0)
  // Named overhead cost lines: [{ name: "Electricity bill", amount: 5000 }, …].
  // totalCost is their sum (the figure the reconciliation uses).
  costs          Json      @default("[]")
  issuedBy       String
  receivedBy     String?
  date           DateTime?
  remarks        String?   @db.Text
  createdAt      DateTime  @default(now())
  batch          Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Stage 8 — Dispatch officer (named BatchDispatch to avoid clashing with Dispatch)
model BatchDispatch {
  id             String    @id @default(cuid())
  batchId        String    @unique
  dispatchId     String    @unique // DSP-0001
  product        String
  quantity       Float     @default(0)
  sourceLocation String?
  destination    String?
  transportCost  Float     @default(0)
  dispatchedBy   String
  toBeReceivedBy String?
  date           DateTime?
  remarks        String?   @db.Text
  createdAt      DateTime  @default(now())
  batch          Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Stage 9 — Receiving officer
model Receiving {
  id               String   @id @default(cuid())
  batchId          String   @unique
  dispatchId       String?
  product          String
  quantityReceived Float    @default(0)
  condition        String?
  variance         Float    @default(0)
  receiver         String
  images           Json     @default("[]")
  remarks          String?  @db.Text
  createdAt        DateTime @default(now())
  batch            Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// ── Fungiculture (mushroom cultivation) subsystem ──────────────────────────
// A full mushroom-production tracking pipeline for in-house growing — spawn
// is independent inventory consumed across many batches; FungiBatch is the
// substrate-to-harvest cycle, strictly-sequential with its own (shorter)
// stage list, all owned by the `fungiculturist` role. GrowingHouse and
// GrainType are admin-managed reference data feeding into it.

// Physical growing houses/rooms batches are hung in during incubation.
// Simple admin-managed reference data — unlike the no-FK soft references used
// elsewhere in this schema (e.g. Batch.lpoId, FungiBatch.spawnId, which stay
// decoupled because they cross into independent subsystems/inventory), this
// uses a real FK: it's a small, low-churn lookup table, and the capacity
// warning needs an efficient indexed count.
model GrowingHouse {
  id             String   @id @default(cuid())
  code           String   @unique // GH-0001
  name           String
  country        String   @default("Kenya") // Kenya | Tanzania, same representation as User.country
  region         String?
  location       String?  @db.Text
  lengthM        Float?
  widthM         Float?
  maxBagCapacity Int      @default(0)
  status         String   @default("active") // active | inactive
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  incubations FungiIncubation[]
}

// Manageable list of spawn grain types (replaces the old hardcoded array).
// Rarely deleted — deactivate via `active` instead.
model GrainType {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spawn FungiSpawn[]
}

// Grain spawn, produced independently and consumed across many FungiBatches.
model FungiSpawn {
  id                  String    @id @default(cuid())
  code                String    @unique // SPN-0001
  grainTypeId         String
  quantityKg          Float     @default(0)
  sterilizedAt        DateTime?
  inoculatedAt        DateTime?
  colonizationPercent Float?
  breakShakeAt        DateTime?
  status              String    @default("sterilizing") // sterilizing | incubating | ready | depleted | contaminated
  remarks             String?   @db.Text
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  grainType GrainType @relation(fields: [grainTypeId], references: [id], onDelete: Restrict)
}

model FungiBatch {
  id      String @id @default(cuid())
  code    String @unique // FUN-0001
  stage   String @default("substrate_prep") // substrate_prep | incubation | harvest | dehydration_packaging
  status  String @default("in_progress") // in_progress | completed
  spawnId String? // read-only link to FungiSpawn.id, no FK — same convention as Batch.lpoId
  // Set when the fungiculturist closes the harvest window (see FungiHarvest).
  // Until then the batch sits on the harvest stage collecting flushes.
  harvestClosedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  substrate   FungiSubstrate?
  incubation  FungiIncubation?
  harvests    FungiHarvest[]
  dehydration FungiDehydration?
}

// Stage 1 — substrate preparation (chop, mix, soak, pack, pasteurize, cool)
model FungiSubstrate {
  id               String     @id @default(cuid())
  batchId          String     @unique
  strawKg          Float      @default(0)
  limeKg           Float      @default(0)
  branKg           Float      @default(0)
  cottonSeedCakeKg Float      @default(0)
  soakHours        Float      @default(12)
  bagCount         Int        @default(0)
  bagWeightKg      Float      @default(2)
  pasteurizeHours  Float      @default(4)
  coolHours        Float      @default(4)
  remarks          String?    @db.Text
  createdAt        DateTime   @default(now())
  batch            FungiBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Stage 2 — inoculation through pinning, hung in a GrowingHouse
model FungiIncubation {
  id             String        @id @default(cuid())
  batchId        String        @unique
  inoculatedAt   DateTime?
  hangAt         DateTime? // moved into the growing house
  growingHouseId String?
  pinningAt      DateTime?
  images         Json          @default("[]")
  remarks        String?       @db.Text
  createdAt      DateTime      @default(now())
  batch          FungiBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  growingHouse   GrowingHouse? @relation(fields: [growingHouseId], references: [id], onDelete: SetNull)

  @@index([growingHouseId])
}

// Stage 3 — harvest, split between fresh punnets and drying stock.
// A mushroom bed fruits REPEATEDLY: each fruiting is a "flush", and one batch
// yields several over weeks. So this is 1:many (unlike every other stage row),
// numbered per batch by `flushNumber`. The batch stays on the harvest stage
// collecting flushes until the fungiculturist explicitly closes the harvest
// (FungiBatch.harvestClosedAt), which is what advances it to dehydration.
model FungiHarvest {
  id                String     @id @default(cuid())
  batchId           String
  flushNumber       Int        @default(1) // 1st, 2nd, 3rd… fruiting of this batch
  harvestedAt       DateTime   @default(now())
  totalWeightKg     Float      @default(0)
  freshPunnets250g  Int        @default(0) // fresh, packed for orders
  weightForDryingKg Float      @default(0) // remainder, sliced for dehydrator
  harvestedBy       String?
  images            Json       @default("[]")
  remarks           String?    @db.Text
  createdAt         DateTime   @default(now())
  batch             FungiBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, flushNumber])
  @@index([batchId])
}

// Stage 4 (final) — dehydration + packaging. Mushrooms lose significant
// weight drying — driedWeightKg vs harvest.weightForDryingKg is how the UI
// computes and shows that shrinkage/yield %.
model FungiDehydration {
  id            String     @id @default(cuid())
  batchId       String     @unique
  driedAt       DateTime?
  driedWeightKg Float      @default(0)
  packagingType String? // paper tube | moisture-proof pouch
  packagedUnits Int        @default(0)
  remarks       String?    @db.Text
  batch         FungiBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// ── Livestock subsystem ─────────────────────────────────────────────────────
// Ongoing animal-husbandry records — not a stage pipeline like Fungiculture/
// Batch, just housing + animal/herd records + feed consumption + production
// output, all owned by the `livestock_manager` role. Mirrors the Fungiculture
// subsystem's conventions (numbered codes, admin-managed reference data,
// SetNull FKs on logs so history survives a housing/animal being retired).

// Physical housing — barn, pen, coop, paddock, etc.
model LivestockHousing {
  id        String   @id @default(cuid())
  code      String   @unique // LH-0001
  name      String
  type      String   @default("pen") // barn | pen | coop | paddock | pasture | other
  country   String   @default("Kenya") // Kenya | Tanzania, same representation as User.country
  region    String?
  location  String?  @db.Text
  capacity  Int      @default(0)
  status    String   @default("active") // active | inactive
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animals        LivestockAnimal[]
  feedingLogs    FeedingLog[]
  LivestockYield LivestockYield[]
}

// An individual animal (tagId set) or a herd/flock group entry (tagId null,
// groupCount > 1 — e.g. "50 broilers"). Both share the same record shape.
model LivestockAnimal {
  id           String    @id @default(cuid())
  code         String    @unique // LA-0001
  tagId        String?   @unique // ear-tag/ring number for an individually tracked animal
  name         String? // friendly name/label (e.g. "Bessie", or a herd label like "East Coop Batch A")
  species      String // cattle | goat | sheep | poultry | pig | rabbit | bee | other
  breed        String?
  sex          String    @default("mixed") // male | female | mixed
  groupCount   Int       @default(1) // 1 for a single animal, >1 for a herd/flock record
  dob          DateTime?
  acquiredAt   DateTime?
  source       String? // purchased | born_on_site | donated
  weightKg     Float?
  healthStatus String    @default("healthy") // healthy | sick | quarantine | deceased
  status       String    @default("active") // active | sold | deceased | transferred
  housingId    String?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  housing     LivestockHousing? @relation(fields: [housingId], references: [id], onDelete: SetNull)
  feedingLogs FeedingLog[]
  yields      LivestockYield[]

  @@index([housingId])
}

// Manageable list of feed types (mirrors GrainType). Rarely deleted —
// deactivate via `active` instead.
model FeedType {
  id        String   @id @default(cuid())
  name      String   @unique
  unit      String   @default("kg") // kg | bags | liters
  stockQty  Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedingLogs FeedingLog[]
}

// A feeding event — consumes stock from a FeedType, against a housing unit
// and/or a specific animal record.
model FeedingLog {
  id         String   @id @default(cuid())
  feedTypeId String
  housingId  String?
  animalId   String?
  quantity   Float    @default(0)
  fedAt      DateTime @default(now())
  loggedBy   String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  feedType FeedType          @relation(fields: [feedTypeId], references: [id], onDelete: Restrict)
  housing  LivestockHousing? @relation(fields: [housingId], references: [id], onDelete: SetNull)
  animal   LivestockAnimal?  @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@index([housingId])
  @@index([animalId])
  @@index([feedTypeId])
}

// Production output — eggs, milk, meat, offspring, wool, honey, etc.
model LivestockYield {
  id         String   @id @default(cuid())
  animalId   String?
  housingId  String?
  type       String // eggs | milk | meat | offspring | wool | honey | other
  quantity   Float    @default(0)
  unit       String   @default("kg") // kg | liters | units | dozen
  recordedAt DateTime @default(now())
  recordedBy String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  animal  LivestockAnimal?  @relation(fields: [animalId], references: [id], onDelete: SetNull)
  housing LivestockHousing? @relation(fields: [housingId], references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([housingId])
}

// ─── Agro Forestry ──────────────────────────────────────────────────────────
// Mirrored from the EarthLungs reforestation Supabase project. Unlike the rest
// of this schema (cuid strings, Prisma-default table names), these models keep
// the SOURCE table/column names and serial Int primary keys via @map/@@map —
// so rows copy across by their original id and the foreign keys between them
// stay intact without an id-rewrite pass. See scripts/import-agroforestry.mjs.

// A smallholder enrolled in a reforestation / agroforestry project.
model Farmer {
  id                     Int      @id @default(autoincrement())
  fullname               String
  gender                 String
  group                  String?
  email                  String?
  phoneNumber            String?  @map("phone_number")
  county                 String
  subCounty              String?  @map("sub_county")
  projectType            String   @map("project_type")
  landOwnershipType      String   @map("land_ownership_type")
  idNumber               String   @map("id_number")
  numberOfAcresCommitted Float?   @map("number_of_acres_committed")
  // Signed agreements held against this farmer:
  // [{ url, filename, uploadedAt, uploadedBy }]. PDFs live in DocAttachment and
  // are served by /api/attachments/<id>.pdf; photos of a signed page are
  // Cloudinary URLs. A column rather than a table because it is a short,
  // always-loaded-with-the-farmer list — and it is one more column the source
  // project does not have, which is fine: nothing syncs back to it.
  contracts              Json     @default("[]")
  createdAt              DateTime @default(now()) @db.Timestamp(6)
  updatedAt              DateTime @updatedAt @db.Timestamp(6)

  disbursements ItemDisbursement[]

  @@index([county])
  @@index([projectType])
  @@map("farmers")
}

// A physical hive. `beehiveId` is the field tag written on the hive itself —
// a text code, NOT this row's numeric id (that clash is the source schema's,
// kept as-is so the columns line up on import).
model Beehive {
  id                    Int      @id @default(autoincrement())
  beehiveId             String
  beehiveType           String // LANGSSTROTH | KTBH | CATCHER_BOX (source enum public."BeehiveType")
  isColonized           Boolean  @default(false)
  latitude              Float?
  longitude             Float?
  uploadedEvidenceCount Int      @default(0)
  // Soft reference to the source BaitingReport — that subsystem is not
  // mirrored here, so no FK, same convention as Batch.lpoId.
  baitingReportId       Int?
  createdAt             DateTime @default(now()) @db.Timestamp(6)
  updatedAt             DateTime @updatedAt @db.Timestamp(6)

  disbursed DisbursedBeehive[]

  @@index([beehiveType])
}

// Seedling species reference list. Plural model name matches the source table
// the FK points at. `seedlingSpicies` keeps the source's spelling.
model Seedlings {
  id              Int      @id @default(autoincrement())
  seedlingSpicies String
  createdAt       DateTime @default(now()) @db.Timestamp(6)

  disbursed DisbursedSeedling[]
}

// One handover event: what a farmer received, from whom, where, and when.
// The actual items live in the two child tables below — a single disbursement
// can carry both beehives and seedlings.
model ItemDisbursement {
  id                 Int      @id @default(autoincrement())
  disbursedBy        String
  itemDisbursed      String
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @db.Timestamp(6)
  disbursementCentre String
  disbursementDate   DateTime @db.Timestamp(6)
  farmerId           Int

  farmer    Farmer              @relation(fields: [farmerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  beehives  DisbursedBeehive[]
  seedlings DisbursedSeedling[]

  @@index([farmerId])
  @@index([disbursementDate])
}

// Beehives handed over — one row per physical hive, hence no quantity column.
model DisbursedBeehive {
  id             Int @id @default(autoincrement())
  disbursementId Int
  beehiveId      Int

  disbursement ItemDisbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  beehive      Beehive          @relation(fields: [beehiveId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([disbursementId])
  @@index([beehiveId])
}

// Seedlings handed over — counted, so this one carries a quantity. Its parent
// link is nullable (onDelete: SetNull) in the source schema, so rows can
// outlive the disbursement they came from.
model DisbursedSeedling {
  id                 Int  @id @default(autoincrement())
  quantity           Int
  seedlingId         Int
  itemDisbursementId Int?

  itemDisbursement ItemDisbursement? @relation(fields: [itemDisbursementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  seedling         Seedlings         @relation(fields: [seedlingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([itemDisbursementId])
  @@index([seedlingId])
}
